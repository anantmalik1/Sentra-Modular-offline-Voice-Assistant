# =======================================================
# SENTRA AI 2.0 CONFIGURATION TEMPLATE
# Copy to .env and fill in your details
# =======================================================

# Mistral AI API Key for online reasoning & multi-language code generation
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Email Sender configuration (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Server Configuration
SENTRA_HOST=0.0.0.0
SENTRA_PORT=5000
SENTRA_DEBUG=False

# Voice Settings
# Leave blank for default system microphone
DEFAULT_MIC_INDEX=
SPEECH_RATE=170
SPEECH_VOLUME=1.0
LANGUAGE=en-IN

# Mode: hybrid, online, offline
SENTRA_MODE=hybrid
